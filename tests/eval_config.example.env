# Copy to a local ignored .env file; never commit real values.
AGENT_EVAL_ADAPTER=http
AGENT_EVAL_BASE_URL=http://localhost:8000
AGENT_EVAL_ENDPOINT=/chat
AGENT_EVAL_TIMEOUT_SECONDS=120
AGENT_EVAL_USER_ID=eval-user
# For a non-HTTP target: AGENT_EVAL_ADAPTER=command and a command reading JSON stdin.
# AGENT_EVAL_COMMAND=python tests/my_adapter.py
AGENT_EVAL_CODE_REVISION=working-tree
