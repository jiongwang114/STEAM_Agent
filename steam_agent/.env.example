# Required
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
STEAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults shown
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_FAST_MODEL=deepseek-chat
# LLM_CANDIDATE_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2048
# LLM_REQUEST_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=1
# Provider prices change over time; set current CNY per 1M tokens for cost reports.
# LLM_INPUT_CNY_PER_MILLION=0
# LLM_OUTPUT_CNY_PER_MILLION=0
# AGENT_EXPERIMENT_NAME=
# AGENT_EXPERIMENT_CANDIDATE_PERCENT=0
# AGENT_MAX_TOOL_ROUNDS=4
# AGENT_MAX_TOOL_CALLS_PER_ROUND=3
# AGENT_MAX_TOTAL_TOKENS=16000
# AGENT_MAX_WALL_SECONDS=60
# AGENT_FINALIZE_MAX_TOKENS=512
# AGENT_MAX_REPAIR_ATTEMPTS=1
# AGENT_HISTORY_TOKEN_BUDGET=6000
# AGENT_CONTEXT_WINDOW_TOKENS=64000
# AGENT_TOOL_CONTEXT_RESERVE_TOKENS=4096
# AGENT_HISTORY_COMPRESSION_THRESHOLD=0.90
# AGENT_SUMMARY_MAX_TOKENS=512
# MEMORY_SNAPSHOT_MAX_ITEMS=12
# MEMORY_SNAPSHOT_MAX_CHARS=1800
# MEMORY_AGENT_ENABLED=true
# MEMORY_AGENT_POLL_SECONDS=15
# MEMORY_AGENT_BATCH_SIZE=5
# MEMORY_AGENT_MAX_ATTEMPTS=5
# MEMORY_AGENT_LEASE_SECONDS=300
# MEMORY_AGENT_RETRY_BASE_SECONDS=30
# MEMORY_AGENT_MIN_CONFIDENCE=0.85
# TOOL_TIMEOUT_SECONDS=12
# TOOL_MAX_RETRIES=1
# STEAM_PROFILE_WARMUP_TIMEOUT_SECONDS=5
# TOOL_CIRCUIT_FAILURE_THRESHOLD=3
# TOOL_CIRCUIT_COOLDOWN_SECONDS=30
# TOOL_RESULT_MAX_CHARS=12000
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_RERANK_WEIGHT=0.50
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=steam-agent
# HOST=0.0.0.0
# PORT=8000
# SESSION_COOKIE_NAME=steam_session
