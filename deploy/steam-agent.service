[Unit]
Description=Steam Agent API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/steam-agent
EnvironmentFile=/home/%i/steam-agent/.env
ExecStart=/home/%i/steam-agent/.venv/bin/python -m api.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
